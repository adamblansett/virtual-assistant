# AI Provider Configuration (mock | gemini | openai)
AI_PROVIDER=mock

# Google Gemini API Key (Optional if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI Compatible API Configuration (Optional if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google OAuth 2.0 Credentials (for live Gmail API integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Application Settings
PORT=3000
NODE_ENV=development
