# ==============================================================================
# Open-Source AI Virtual Assistant - Environment Configuration Template
# ==============================================================================

# Application & Server
NODE_ENV=production
PORT=3000

# AI Provider Credentials (BYOK - Bring Your Own Key)
# Configure one or both of the following:
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google OAuth 2.0 Credentials (Gmail & Google Calendar)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Mobile Messaging Gateway (Telegram Bot)
# Create a bot via @BotFather on Telegram to get your bot token
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/webhooks/telegram
TELEGRAM_WEBHOOK_SECRET=

# Security & Credential Encryption at Rest (AES-256-GCM)
# Optional Bearer/X-API-Key token to protect API routes when exposed on a network
ASSISTANT_ACCESS_TOKEN=
# Secret passphrase used to derive the AES-256-GCM key for encrypting stored API keys & OAuth tokens
VAULT_ENCRYPTION_SECRET=

# Optional Live Telemetry & Web Research APIs
AVIATIONSTACK_API_KEY=
SERPER_API_KEY=

# Storage & Sandboxed File Path
# Defaults to ./data within project or container
DATA_DIR=./data
SANDBOXED_FILES_DIR=./workspace_files
